{% extends 'base.html.twig' %}

{% block title %}Benevole index{% endblock %}

{% block body %}
    <h1>Benevole index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Email</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for benevole in benevoles %}
            <tr>
                <td>{{ benevole.id }}</td>
                <td>{{ benevole.email }}</td>
                <td>{{ benevole.nom }}</td>
                <td>{{ benevole.prenom }}</td>
                <td>
                    <a href="{{ path('app_benevole_show', {'id': benevole.id}) }}">Voir</a>
                    {% if app.user.id == benevole.id %}
                        <a href="{{ path('app_benevole_edit', {'id': benevole.id}) }}">Modifier</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Pas de bénevoles trouvés</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_benevole_new') }}">Ajouter</a>
{% endblock %}
