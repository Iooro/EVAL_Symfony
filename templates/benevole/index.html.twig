{% extends 'base.html.twig' %}

{% block title %}Benevole index{% endblock %}

{% block body %}
    <h1 class="h2 mb-4">Benevole index</h1>

    <div class="table-responsive border rounded-3 bg-white mb-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Email</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for benevole in benevoles %}
            <tr>
                <td>{{ benevole.id }}</td>
                <td>{{ benevole.email }}</td>
                <td>{{ benevole.nom }}</td>
                <td>{{ benevole.prenom }}</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ path('app_benevole_show', {'id': benevole.id}) }}">Voir</a>
                    {% if app.user.id == benevole.id %}
                        <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ path('app_benevole_edit', {'id': benevole.id}) }}">Modifier</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Pas de bénevoles trouvés</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    <a class="btn btn-primary mb-2" href="{{ path('app_benevole_new') }}">Ajouter</a>
{% endblock %}
