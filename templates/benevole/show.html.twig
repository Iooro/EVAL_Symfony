{% extends 'base.html.twig' %}

{% block title %}Benevole{% endblock %}

{% block body %}
    <h1 class="h2 mb-4">Benevole</h1>

    <div class="table-responsive border rounded-3 bg-white mb-4">
    <table class="table table-hover align-middle mb-0">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ benevole.id }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ benevole.email }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ benevole.nom }}</td>
            </tr>
            <tr>
                <th>Prenom</th>
                <td>{{ benevole.prenom }}</td>
            </tr>
        </tbody>
    </table>
    </div>

    <a class="btn btn-outline-secondary mb-2" href="{{ path('app_benevole_index') }}">Retour</a>
    {% if app.user.id == benevole.id %}
        <a class="btn btn-outline-success me-1 mb-1" href="{{ path('app_benevole_edit', {'id': benevole.id}) }}">Modifier</a>
    {% endif %}
    {{ include('benevole/_delete_form.html.twig') }}
{% endblock %}
