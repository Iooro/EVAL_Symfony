<form method="post" action="{{ path('app_benevole_delete', {'id': benevole.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ benevole.id) }}">
    {% if app.user.id == benevole.id %}
        <button class="btn btn-outline-danger mt-2">Supprimer</button>
    {% endif %}
</form>
