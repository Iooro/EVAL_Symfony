{% extends 'base.html.twig' %}

{% block title %}Lieu{% endblock %}

{% block body %}
    <h1 class="h2 mb-4">Lieu</h1>

    <div class="table-responsive border rounded-3 bg-white mb-4">
    <table class="table table-hover align-middle mb-0">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ lieu.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ lieu.nom }}</td>
            </tr>
            <tr>
                <th>Adresse</th>
                <td>{{ lieu.adresse }}</td>
            </tr>
            <tr>
                <th>Quartier</th>
                <td>{{ lieu.quartier }}</td>
            </tr>
            <tr>
                <th>Latitude</th>
                <td>{{ lieu.latitude }}</td>
            </tr>
            <tr>
                <th>Longitude</th>
                <td>{{ lieu.longitude }}</td>
            </tr>
        </tbody>
    </table>
    </div>

    <a class="btn btn-outline-secondary mb-2" href="{{ path('app_lieu_index') }}">Retour</a>

    <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ path('app_lieu_edit', {'id': lieu.id}) }}">Modifier</a>

    {{ include('lieu/_delete_form.html.twig') }}
{% endblock %}
