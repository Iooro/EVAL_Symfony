{% extends 'base.html.twig' %}

{% block title %}Technique index{% endblock %}

{% block body %}
    <h1 class="h2 mb-4">Technique index</h1>

    <div class="table-responsive border rounded-3 bg-white mb-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for technique in techniques %}
            <tr>
                <td>{{ technique.id }}</td>
                <td>{{ technique.nom }}</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ path('app_technique_show', {'id': technique.id}) }}">Voir</a>
                    <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ path('app_technique_edit', {'id': technique.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Pas de techniques trouvées</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    <a class="btn btn-primary mb-2" href="{{ path('app_technique_new') }}">Ajouter</a>
{% endblock %}
