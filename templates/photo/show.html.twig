{% extends 'base.html.twig' %}

{% block title %}Photo{% endblock %}

{% block body %}
    <h1>Photo</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ photo.id }}</td>
            </tr>
            <tr>
                <th>Date prise de vue</th>
                <td>{{ photo.datePriseVue ? photo.datePriseVue|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Nom du fichier</th>
                <td>{{ photo.nomFichier }}</td>
            </tr>
            <tr>
                <th>Etat de l'oeuvre</th>
                <td>{{ photo.etatOeuvre }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_photo_index') }}">Retour</a>

    <a href="{{ path('app_photo_edit', {'id': photo.id}) }}">Modifier</a>

    {{ include('photo/_delete_form.html.twig') }}
{% endblock %}
