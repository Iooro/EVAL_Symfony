{% extends 'base.html.twig' %}

{% block title %}Photo index{% endblock %}

{% block body %}
    <h1 class="h2 mb-4">Photo index</h1>

    <div class="table-responsive border rounded-3 bg-white mb-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Date prise de vue</th>
                <th>Nom fichier</th>
                <th>Etat de l'oeuvre</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for photo in photos %}
            <tr>
                <td>{{ photo.id }}</td>
                <td>{{ photo.datePriseVue ? photo.datePriseVue|date('Y-m-d') : '' }}</td>
                <td>{{ photo.nomFichier }}</td>
                <td>{{ photo.etatOeuvre }}</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ path('app_photo_show', {'id': photo.id}) }}">Voir</a>
                    <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ path('app_photo_edit', {'id': photo.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Pas de photos trouvées</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    <a class="btn btn-primary mb-2" href="{{ path('app_photo_new') }}">Ajouter</a>
{% endblock %}
