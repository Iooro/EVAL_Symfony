{% extends 'base.html.twig' %}

{% block title %}Oeuvre index{% endblock %}

{% block body %}
    <h1 class="h2 mb-4">Oeuvre index</h1>

    <div class="table-responsive border rounded-3 bg-white mb-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Date de creation</th>
                <th>Description</th>
                <th>Est detruite ?</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for oeuvre in oeuvres %}
            <tr>
                <td>{{ oeuvre.id }}</td>
                <td>{{ oeuvre.titre }}</td>
                <td>{{ oeuvre.dateCreation ? oeuvre.dateCreation|date('Y-m-d') : '' }}</td>
                <td>{{ oeuvre.description }}</td>
                <td>{{ oeuvre.estDetruite ? 'Oui' : 'Non' }}</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ path('app_oeuvre_show', {'id': oeuvre.id}) }}">Voir</a>
                    <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Pas d'oeuvres trouvées</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    <a class="btn btn-primary mb-2" href="{{ path('app_oeuvre_new') }}">Ajouter</a>
{% endblock %}
