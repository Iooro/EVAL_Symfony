{% extends 'base.html.twig' %}

{% block title %}Oeuvre{% endblock %}

{% block body %}
    <h1 class="h2 mb-4">Oeuvre</h1>

    <div class="table-responsive border rounded-3 bg-white mb-4">
    <table class="table table-hover align-middle mb-0">
        <body>
            <tr>
                <th>Photos</th>
                <td>
                    <div class="d-flex flex-wrap gap-3">
                        {% for photo in oeuvre.photos %}
                            <div class="card" style="width: 18rem;">
                                <img src="{{ asset(photo.nomFichier) }}" class="card-img-top oeuvre-photo rounded-2 object-fit-cover" alt="{{ oeuvre.titre }}" loading="lazy">
                                <div class="card-body">
                                    <p class="card-text">Commentaire : {{ photo.etatOeuvre }}</p>
                                    <p class="card-text"><small>Date de prise : {{ photo.datePriseVue ? photo.datePriseVue|date('Y-m-d') : '' }}</small></p>
                                </div>
                            </div>
                        {% else %}
                            <span class="text-body-secondary">Aucune photo</span>
                        {% endfor %}
                    </div>
                </td>
            </tr>
            <tr>
                <th>Id</th>
                <td>{{ oeuvre.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ oeuvre.titre }}</td>
            </tr>
            <tr>
                <th>Artistes</th>
                <td>
                    {% for artiste in oeuvre.idArtiste %}
                        {{ artiste.pseudonyme }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        Aucun artiste
                    {% endfor %}
                </td>            </tr>
            <tr>
                <th>Techniques</th>
                <td>{% for technique in oeuvre.idTechnique %} {{ technique.nom }} ,{% endfor %}</td>
            </tr>
            <tr>
                <th>Date de creation</th>
                <td>{{ oeuvre.dateCreation ? oeuvre.dateCreation|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ oeuvre.description }}</td>
            </tr>
            <tr>
                <th>Est detruite ?</th>
                <td>{{ oeuvre.estDetruite ? 'Oui' : 'Non' }}</td>
            </tr>
        </tbody>
    </table>
    </div>

    <a class="btn btn-outline-secondary mb-2" href="{{ path('app_oeuvre_index') }}">Retour</a>

    <a class="btn btn-outline-success me-1 mb-1" href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}">Modifier</a>

    {{ include('oeuvre/_delete_form.html.twig') }}
{% endblock %}
