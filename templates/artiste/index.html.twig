{% extends 'base.html.twig' %}

{% block title %}Artiste index{% endblock %}

{% block body %}
    <h1>Artiste index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Pseudonyme</th>
                <th>Nom réel</th>
                <th>Biographie</th>
                <th>Nationalité</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for artiste in artistes %}
            <tr>
                <td>{{ artiste.id }}</td>
                <td>{{ artiste.pseudonyme }}</td>
                <td>{{ artiste.nomReel }}</td>
                <td>{{ artiste.bio }}</td>
                <td>{{ artiste.nationalite }}</td>
                <td>
                    <a href="{{ path('app_artiste_show', {'id': artiste.id}) }}">Voir</a>
                    <a href="{{ path('app_artiste_edit', {'id': artiste.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Pas d'artistes trouvés</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_artiste_new') }}">Ajouter</a>
{% endblock %}
