{% extends 'base.html.twig' %}

{% block title %}Artiste index{% endblock %}

{% block body %}
    <h1 class="h2 mb-4">Artiste index</h1>

    <div class="table-responsive border rounded-3 bg-white mb-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Pseudonyme</th>
                <th>Nom réel</th>
                <th>Biographie</th>
                <th>Nationalité</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for artiste in artistes %}
            <tr>
                <td>{{ artiste.id }}</td>
                <td>{{ artiste.pseudonyme }}</td>
                <td>{{ artiste.nomReel }}</td>
                <td>{{ artiste.bio }}</td>
                <td>{{ artiste.nationalite }}</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ path('app_artiste_show', {'id': artiste.id}) }}">Voir</a>
                    <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ path('app_artiste_edit', {'id': artiste.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Pas d'artistes trouvés</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    <a class="btn btn-primary mb-2" href="{{ path('app_artiste_new') }}">Ajouter</a>
{% endblock %}
