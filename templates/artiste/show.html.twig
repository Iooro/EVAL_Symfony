{% extends 'base.html.twig' %}

{% block title %}Artiste{% endblock %}

{% block body %}
    <h1 class="h2 mb-4">Artiste</h1>

    <div class="table-responsive border rounded-3 bg-white mb-4">
    <table class="table table-hover align-middle mb-0">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ artiste.id }}</td>
            </tr>
            <tr>
                <th>Pseudonyme</th>
                <td>{{ artiste.pseudonyme }}</td>
            </tr>
            <tr>
                <th>Nom réel</th>
                <td>{{ artiste.nomReel }}</td>
            </tr>
            <tr>
                <th>Biographie</th>
                <td>{{ artiste.bio }}</td>
            </tr>
            <tr>
                <th>Nationalite</th>
                <td>{{ artiste.nationalite }}</td>
            </tr>
        </tbody>
    </table>
    </div>

    <a class="btn btn-outline-secondary mb-2" href="{{ path('app_artiste_index') }}">Retour</a>

    <a class="btn btn-outline-success me-1 mb-1" href="{{ path('app_artiste_edit', {'id': artiste.id}) }}">Modifier</a>

    {{ include('artiste/_delete_form.html.twig') }}
{% endblock %}
