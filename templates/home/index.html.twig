{% extends 'base.html.twig' %}

{% block title %}Art de Rue{% endblock %}

{% block body %}

{% for oeuvre in oeuvres %}
<section class="card" style="max-width: 320px">
  {%  if oeuvre.photos is not empty %}
    <div class="card-img-top">
    <div id="carousel-oeuvre-{{ oeuvre.id }}" class="carousel slide">
        <div class="carousel-inner rounded-2" style="height: 240px;">
        {% for photo in oeuvre.photos %}
            <div class="carousel-item h-100 {{ loop.first ? 'active' : '' }}">
            <img src="{{ asset(photo.nomFichier) }}" class="d-block w-100 h-100 object-fit-cover" alt="{{ oeuvre.titre }}">
            </div>
        {% endfor %}
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <div class="carousel-indicators">
            {% for photo in oeuvre.photos %}
                <button type="button" data-bs-target="#carousel-oeuvre-{{ oeuvre.id }}" data-bs-slide-to="{{ loop.index0 }}" {{ loop.first ? 'class="active" aria-current="true"' }}  aria-label="Slide {{ loop.index }}"></button>
            {% endfor %}
            </div>
        </div>
    </div>
    </div>
  {% endif %}
  <div class="card-body">
    <h4 class="card-title">{{ oeuvre.titre }}</h4>
    <p class="card-text">{{ oeuvre.description }}</p>
    <p class="card-text">L'oeuvre existe toujours : {{ oeuvre.estDetruite ? 'Non' : 'Oui' }}</p>
    {% set dernierePhoto = oeuvre.photos |sort((a, b) => b.datePriseVue <=> a.datePriseVue) |first %}
    <p class="card-text">Dernières nouvelles : {{ dernierePhoto.etatOeuvre }}</p>
    <small class="card-text">Date de découverte : {{ oeuvre.dateCreation ? oeuvre.dateCreation|date('Y-m-d') : '' }}</small>
    <a href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}" class="btn btn-primary">Modifier</a>
    <a href="{{ path('app_oeuvre_show', {'id': oeuvre.id}) }}" class="btn btn-primary">Voir</a>
  </div>
</section>
   
{% else %}
    <tr>
        <td colspan="6">Pas d'oeuvres trouvées</td>
    </tr>
{% endfor %}

{% endblock %}
